{
  "name": "mining-now-backend",
  "version": "1.0.0",
  "description": "Crypto mining shop backend with Express, MySQL, JWT, and clean architecture.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch src --watch server.js",
    "seed": "node seed.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=unit --coverage",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration --coverage"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.0",
    "xss": "^1.0.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "crypto",
    "ecommerce",
    "express",
    "mysql",
    "jwt"
  ],
  "license": "MIT"
}
