PORT=4000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mining_shop
JWT_SECRET=your_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration (requests per 15 minutes)
AUTH_RATE_LIMIT=5              # Login/register attempts
API_RATE_LIMIT=100             # General API endpoints
STRICT_RATE_LIMIT=20           # Sensitive operations (deletes)
CREATE_RATE_LIMIT=50           # Resource creation (POST)
READ_RATE_LIMIT=200            # Read operations (GET)
